      "name": "Kaynak Sayfalari Getir"
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "dataPropertyName": "html",
        "extractionValues": {
          "values": [
            {
              "key": "text",
              "cssSelector": "body",
              "skipSelectors": "script, style, noscript, nav, header, footer"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        672,
        0
      ],
      "id": "17b67b05-f8e1-4fa3-8fa3-7f4dfd8ecadf",
      "name": "Sayfa Metnini Cikar"
    },
    {
      "parameters": {
        "jsCode": "const sources = $(\"Kaynak Listesi\").all();\nconst pages = $input.all();\n\nif (pages.length !== sources.length) {\n  throw new Error(\"Kaynak sayısı ile alınan sayfa sayısı eşleşmiyor.\");\n}\n\nreturn pages.map((page, index) => {\n  const source = sources[index].json;\n\n  const text = String(page.json.text ?? \"\")\n    .replace(/\\\\r\\\\n|\\\\n|\\\\r/g, \"\\n\")\n    .replace(/\\[(?:https?:\\/\\/|\\/)[^\\]]*\\]/g, \"\")\n    .replace(/[ \\t]+/g, \" \")\n    .replace(/\\n\\s*\\n/g, \"\\n\\n\")\n    .trim();\n\n  if (!text) {\n    throw new Error(`Kaynak metni boş: ${source.source_name}`);\n  }\n\n  return {\n    json: {\n      source_name: source.source_name,\n      source_url: source.source_url,\n      text,\n      character_count: text.length\n    },\n    pairedItem: {\n      item: index\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
