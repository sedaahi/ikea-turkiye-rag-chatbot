    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      source_name: \"IKEA Türkiye - Hizmetler\",\n      source_url: \"https://www.ikea.com.tr/hizmetler\"\n    }\n  },\n  {\n    json: {\n      source_name: \"IKEA Türkiye - Mağazadan Teslim Al\",\n      source_url:\n        \"https://www.ikea.com.tr/evden-alisveris-yap-magazadan-teslim-al\"\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "cafaa4c7-3aa0-4ed3-a963-d978d35ed2ec",
      "name": "Kaynak Listesi"
    },
