    {
      "parameters": {
        "jsCode": "const question = $(\"When chat message received\").first().json.chatInput;\n\nconst context = $input.all().map((item, index) => {\n  const document = item.json.document;\n  const metadata = document.metadata;\n\n  return [\n    `Parça ${index + 1}`,\n    `Kaynak: ${metadata.source_name}`,\n    `Bağlantı: ${metadata.source_url}`,\n    `Metin: ${document.pageContent}`\n  ].join(\"\\n\");\n}).join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      question,\n      context\n    }\n  }\n];"
      },
